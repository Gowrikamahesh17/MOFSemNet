# Copy to backend/.env (or export these directly) to override defaults in
# backend/app/core/config.py. None are required for local dev — defaults resolve paths
# relative to the repo root and allow the Vite dev server's origin.

# Where content/*.yaml, data/, outputs/, and papers/ live. Default: repo-root-relative.
# MOFSEMNET_CONTENT_DIR=/app/content
# MOFSEMNET_DATA_DIR=/app/data
# MOFSEMNET_OUTPUTS_DIR=/app/outputs
# MOFSEMNET_PAPERS_DIR=/app/papers

# Comma-separated origins allowed to call the API. Only matters when the frontend is served
# from a different origin than the backend (e.g. local dev with Vite on :5173). In a
# single-container production deploy (Dockerfile.webapp) this isn't used — same origin.
# MOFSEMNET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Which language model backs the live embedding demo on /implemented.
# MOFSEMNET_DEMO_MODEL=chemberta

# How many nearest MOFs the live demo returns per query.
# MOFSEMNET_DEMO_TOP_K=5
